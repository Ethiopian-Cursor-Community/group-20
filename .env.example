# Frontend → Supabase (browser client only; NEVER use service_role here)
# Dashboard: Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cursor Agent SDK — user key from https://cursor.com/dashboard/integrations
# Used by: npm run verify:sdk | npm run agent -- "your prompt"
# Never prefix with VITE_ and never import @cursor/sdk in the browser bundle.
CURSOR_API_KEY=your_cursor_api_key

